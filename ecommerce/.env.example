# --- API ---
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose) ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password
POSTGRES_DB=ecommerce
# Used by the API running on the host machine
DATABASE_URL=postgresql://ecom:ecom_password@localhost:5432/ecommerce?schema=public
# Used by the API container inside docker-compose
DATABASE_URL_DOCKER=postgresql://ecom:ecom_password@db:5432/ecommerce?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Payments (optional, later) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
